[
  {
    "name": "HUD literal import preserves custom argv",
    "before": "MTL_HUD_ENABLED=1 %command% --arg=\"a b\"",
    "safe": true,
    "changes": {
      "metalHud": true
    },
    "after": " %command% --arg=\"a b\""
  },
  {
    "name": "WFUSync explicit zero",
    "before": "WINEWFUSYNC=0 %command%",
    "safe": true,
    "changes": {
      "wfusync": false
    },
    "after": " %command%"
  },
  {
    "name": "old MSync is not WFUSync",
    "before": "WINEMSYNC=1 %command%",
    "safe": true,
    "changes": {},
    "after": "WINEMSYNC=1 %command%",
    "warning": "MSync is not WFUSync"
  },
  {
    "name": "DXMT NVIDIA is one profile",
    "before": "CX_GRAPHICS_BACKEND=dxmt DXMT_ENABLE_NVEXT=1 %command% --custom",
    "safe": true,
    "changes": {
      "backend": "dxmt",
      "upscaling": "nvidia"
    },
    "after": "  %command% --custom"
  },
  {
    "name": "D3DMetal NVIDIA is one profile",
    "before": "CX_GRAPHICS_BACKEND=d3dmetal D3DM_ENABLE_METALFX=1 %command%",
    "safe": true,
    "changes": {
      "backend": "d3dmetal",
      "upscaling": "nvidia"
    },
    "after": "  %command%"
  },
  {
    "name": "automatic backend cannot infer NVIDIA",
    "before": "CX_GRAPHICS_BACKEND=automatic D3DM_ENABLE_METALFX=1 %command%",
    "safe": true,
    "changes": {
      "backend": "inherit"
    },
    "after": " D3DM_ENABLE_METALFX=1 %command%",
    "warning": "ambiguous"
  },
  {
    "name": "DLSS off does not destroy AMD",
    "before": "CX_GRAPHICS_BACKEND=d3dmetal D3DM_ENABLE_METALFX=0 %command%",
    "safe": true,
    "changes": {
      "backend": "d3dmetal"
    },
    "after": " D3DM_ENABLE_METALFX=0 %command%",
    "warning": "ambiguous"
  },
  {
    "name": "conflicting old profile flags",
    "before": "CX_GRAPHICS_BACKEND=dxmt D3DM_ENABLE_METALFX=1 DXMT_ENABLE_NVEXT=1 %command%",
    "safe": true,
    "changes": {
      "backend": "dxmt"
    },
    "after": " D3DM_ENABLE_METALFX=1 DXMT_ENABLE_NVEXT=1 %command%",
    "warning": "ambiguous"
  },
  {
    "name": "unsupported DXVK kept intact",
    "before": "CX_GRAPHICS_BACKEND=dxvk %command%",
    "safe": true,
    "changes": {},
    "after": "CX_GRAPHICS_BACKEND=dxvk %command%",
    "warning": "Unsupported legacy backend"
  },
  {
    "name": "unsupported WineD3D plus independent HUD",
    "before": "CX_GRAPHICS_BACKEND=wined3d MTL_HUD_ENABLED=0 %command%",
